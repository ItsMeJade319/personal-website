<% content_for :title, "Portfolio" %>

<% if notice.present? %>
  <p class="field-border alert98 alert98--success d-flex align-items-center gap-2 mb-3">
    <i class="bi bi-check-circle-fill"></i>
    <%= notice %>
  </p>
<% end %>

<% if admin_signed_in? %>
  <div class="text-end mb-2">
    <%= link_to admin_projects_path, class: "text-decoration-none text-secondary small d-inline-flex align-items-center gap-1" do %>
      <i class="bi bi-pencil"></i>
      Manage portfolio
    <% end %>
  </div>
<% end %>

<div class="window p-0 mb-4">
  <div class="title-bar">
    <div class="title-bar-text">C:\Portfolio &mdash; Explorer</div>
  </div>

  <div class="window-toolbar">
    <span>File</span>
    <span>Edit</span>
    <span>View</span>
    <span>Help</span>
  </div>

  <div class="d-flex align-items-center gap-2 px-2 pb-2">
    <span class="small text-secondary" style="font-family: var(--font-chrome);">Address</span>
    <div class="field-border flex-grow-1 small" style="font-family: var(--font-chrome); padding: 3px 6px;">C:\Projects\</div>
  </div>

  <div class="window-body pb-3">
    <h1 class="mb-2">Portfolio</h1>
    <p class="text-secondary">Things I've built while learning full-stack development</p>
    <hr>

    <div id="projects" class="row row-cols-1 row-cols-md-3 g-4">
      <%= render partial: "projects/project_card", collection: @projects, as: :project %>
    </div>

  </div>
    <% if @projects.none? %>
    <div class="p-4">
      <p class="text-muted mb-0">No projects yet.</p>
    </div>
    <% end %>
</div>
