<div class="py-4">
  <div class="window">
    <div class="title-bar">
      <div class="title-bar-text">blog &mdash; Notepad</div>
    </div>

    <div class="window-body">
      <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
        <div>
          <h2 class="mb-2">Recent Posts</h2>
          <p class="text-secondary mb-0">Notes on what I'm building and learning.</p>
        </div>

        <%= link_to posts_path, class: "btn98 btn98-primary flex-shrink-0 d-inline-flex align-items-center gap-1" do %>
          View all posts
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right-short" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8"/>
          </svg>
        <% end %>
      </div>
      <hr>

      <div class="row row-cols-1 row-cols-md-2 g-4">
        <%= render @recent_posts %>
      </div>
    </div>
  </div>
</div>
