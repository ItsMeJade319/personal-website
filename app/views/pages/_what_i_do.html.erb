<div class="py-4">
  <span class="chip98 mb-3 d-inline-block">What I Do</span>

  <div class="row g-3">

    <div class="col-md-4">
      <div class="window h-100 p-0">
        <div class="title-bar" style="min-height: 24px;">
          <div class="title-bar-text small">fullstack.exe</div>
        </div>
        <div class="window-body d-flex gap-2">
          <%= image_tag "icons/32px/computer.png", alt: "", class: "flex-shrink-0 align-self-start pixel-icon", style: "height: 2rem; width: 2rem; object-fit: contain;" %>
          <div>
            <p class="fw-bold mb-1">Full-Stack Web Apps</p>
            <p class="fw-light mb-0">Building features end to end with Rails, React and PostgreSQL.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="col-md-4">
      <div class="window h-100 p-0">
        <div class="title-bar" style="min-height: 24px;">
          <div class="title-bar-text small">interfaces.exe</div>
        </div>
        <div class="window-body d-flex gap-2">
          <%= image_tag "icons/32px/clipboard.png", alt: "", class: "flex-shrink-0 align-self-start pixel-icon", style: "height: 2rem; width: 2rem; object-fit: contain;" %>
