<div class="py-4">
  <div class="window p-0 mx-auto pb-3" style="max-width: 420px;">
    <div class="title-bar" style="min-height: 24px;">
      <div class="title-bar-text small">Message</div>
    </div>

    <div class="window-body d-flex gap-3 align-items-start">
      <%= image_tag "icons/32px/info.png", alt: "", class: "flex-shrink-0 pixel-icon", style: "height: 2rem; width: 2rem; object-fit: contain;" %>

      <div class="flex-grow-1">
        <p class="fw-bold fs-5 mb-3">Want more details?</p>

        <div class="d-flex gap-2 flex-wrap">
          <%= link_to "View Resume", resume_path, class: "btn98 btn98-primary" %>
        </div>
      </div>
    </div>
  </div>
</div>
