<div id="contact" class="win98-navbar mt-4">
  <div class="container d-flex justify-content-between align-items-center py-2 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <span class="btn98 btn98-primary btn98-sm d-inline-flex align-items-center gap-1">
        <%= image_tag "icons/32px/folder-pink.png", alt: "", class: "flex-shrink-0 pixel-icon", style: "height: 1rem; width: 1rem; object-fit: contain;" %>
        Contact
      </span>

      <%= link_to "mailto:", class: "btn98 btn98-sm d-inline-flex align-items-center gap-1" do %>
        <%= image_tag "icons/32px/mail.png", alt: "", class: "flex-shrink-0 pixel-icon", style: "height: 1rem; width: 1rem; object-fit: contain;" %>
        (your@email.com)
      <% end %>

      <%= link_to "#", class: "btn98 btn98-sm d-inline-flex align-items-center gap-1" do %>
        <%= image_tag "icons/32px/link.png", alt: "", class: "flex-shrink-0 pixel-icon", style: "height: 1rem; width: 1rem; object-fit: contain;" %>
        LinkedIn
      <% end %>
    </div>

    <p class="status-pill mb-0">Bali, Indonesia &middot; &copy; <%= Date.current.year %></p>
  </div>
</div>
