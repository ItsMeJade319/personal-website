<div id="<%= dom_id post %>" class="col">
  <div class="window p-0 h-100 d-flex flex-column">
    <div class="title-bar" style="min-height: 24px;">
      <div class="title-bar-text small">post_<%= format("%02d", (local_assigns[:post_counter] || 0) + 1) %>.txt</div>
    </div>

    <div class="window-body d-flex flex-column flex-grow-1">
      <% if post.image.attached? %>
        <div class="paint-frame mb-3">
          <%= image_tag post.image.variant(resize_to_limit: [ 600, 400 ]), style: "height: 180px; width: 100%; object-fit: cover;" %>
        </div>
      <% end %>

      <h3 class="h6 mb-1">
        <%= link_to post.title, post, class: "text-decoration-none text-dark" %>
      </h3>
      <p class="text-secondary small flex-grow-1"><%= truncate(post.body.to_s, length: 160, separator: " ") %></p>

      <div class="mb-3">
        <%= link_to post, class: "btn98 btn98-primary btn98-sm d-inline-flex align-items-center gap-1" do %>
          Read more
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-right-short" viewBox="0 0 16 16">
            <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8"/>
          </svg>
        <% end %>
      </div>

      <div class="status-bar mt-auto">
        <% if post.published_at.present? %>
          <p class="status-bar-field mb-0"><%= post.published_at.strftime("%B %-d, %Y") %></p>
        <% end %>
        <% unless post.published? %>
          <p class="status-bar-field mb-0">Draft</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
