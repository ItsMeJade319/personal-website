<% content_for :title, "Admin dashboard" %>

<div class="admin-header d-flex justify-content-between align-items-center flex-wrap gap-3">
  <div>
    <p class="admin-title fs-3 mb-1">Admin dashboard</p>
    <p class="admin-subtitle mb-0">Manage your portfolio, gallery, and blog posts</p>
  </div>

  <div class="d-flex align-items-center gap-3">
    <span class="text-secondary d-inline-flex align-items-center gap-2">
      <i class="bi bi-person-circle"></i>
      <%= current_admin.email %>
    </span>
    <%= button_to destroy_admin_session_path, method: :delete, class: "d-inline-flex align-items-center gap-1", form: { data: { turbo_confirm: "Are you sure you want to sign out?" } } do %>
      <i class="bi bi-box-arrow-right"></i>
      Sign out
    <% end %>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-journal-richtext"></i></div>
      <div>
        <p class="stat-value mb-0"><%= @projects.size %></p>
        <p class="stat-label mb-0">Projects</p>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
      <div>
        <p class="stat-value mb-0"><%= @projects.count(&:published?) %></p>
        <p class="stat-label mb-0">Published projects</p>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-image"></i></div>
      <div>
        <p class="stat-value mb-0"><%= @artworks.size %></p>
        <p class="stat-label mb-0">Artwork</p>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
      <div>
        <p class="stat-value mb-0"><%= @artworks.count(&:published?) %></p>
        <p class="stat-label mb-0">Published artwork</p>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-file-post"></i></div>
      <div>
        <p class="stat-value mb-0"><%= @posts.size %></p>
        <p class="stat-label mb-0">Posts</p>
      </div>
    </div>
  </div>

  <div class="col-6 col-md-4 col-lg-2">
    <div class="stat-card">
      <div class="stat-icon"><i class="bi bi-check2-circle"></i></div>
      <div>
        <p class="stat-value mb-0"><%= @posts.count(&:published?) %></p>
        <p class="stat-label mb-0">Published posts</p>
      </div>
    </div>
  </div>
</div>

<div class="admin-panel mb-4">
  <div class="admin-panel-header">
    <p class="fw-bold text-uppercase mb-0">Drafts (<%= @drafts.size %>)</p>
  </div>

  <% @drafts.each do |item| %>
    <div class="admin-list-item">
      <% if item.image.attached? %>
        <%= image_tag item.image.variant(resize_to_limit: [ 80, 80 ]), class: "admin-thumb" %>
      <% else %>
        <div class="admin-thumb-placeholder"><i class="bi bi-image"></i></div>
      <% end %>

      <div class="flex-grow-1" style="min-width: 0;">
        <span class="status-pill mb-1"><%= item.class.name %></span>
        <%= link_to item.to_s.presence || "##{item.id}", polymorphic_path(item), class: "d-block text-body text-decoration-none fw-semibold text-truncate" %>
      </div>

      <div class="d-flex gap-2 flex-shrink-0">
        <%= link_to edit_polymorphic_path(item, return_to: request.original_fullpath), class: "btn98 btn98-sm" do %>
          <i class="bi bi-pencil"></i>
        <% end %>
        <%= button_to polymorphic_path(item, return_to: request.original_fullpath), method: :delete, class: "text-danger", form: { data: { turbo_confirm: "Are you sure?" } } do %>
          <i class="bi bi-trash"></i>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @drafts.empty? %>
    <p class="admin-list-empty mb-0">No drafts &mdash; everything is published.</p>
  <% end %>
</div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="admin-panel">
      <div class="admin-panel-header">
        <p class="fw-bold text-uppercase mb-0">Portfolio</p>
        <%= link_to new_project_path(return_to: request.original_fullpath), class: "btn98 btn98-sm default d-inline-flex align-items-center gap-1" do %>
          <i class="bi bi-plus-lg"></i>
          New project
        <% end %>
      </div>

      <% @recent_projects.each do |project| %>
        <%= render "projects/admin_row", project: project %>
      <% end %>

      <% if @projects.none? %>
        <p class="admin-list-empty mb-0">No projects yet.</p>
      <% end %>

      <div class="p-3 text-center border-top">
        <%= link_to "See all projects", admin_projects_path, class: "btn98 btn98-sm" %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="admin-panel">
      <div class="admin-panel-header">
        <p class="fw-bold text-uppercase mb-0">Gallery</p>
        <%= link_to new_artwork_path(return_to: request.original_fullpath), class: "btn98 btn98-sm default d-inline-flex align-items-center gap-1" do %>
          <i class="bi bi-plus-lg"></i>
          New artwork
        <% end %>
      </div>

      <% @recent_artworks.each do |artwork| %>
        <%= render "artworks/admin_row", artwork: artwork %>
      <% end %>

      <% if @artworks.none? %>
        <p class="admin-list-empty mb-0">No artwork yet.</p>
      <% end %>

      <div class="p-3 text-center border-top">
        <%= link_to "See all artwork", admin_artworks_path, class: "btn98 btn98-sm" %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="admin-panel">
      <div class="admin-panel-header">
        <p class="fw-bold text-uppercase mb-0">Posts</p>
        <%= link_to new_post_path(return_to: request.original_fullpath), class: "btn98 btn98-sm default d-inline-flex align-items-center gap-1" do %>
          <i class="bi bi-plus-lg"></i>
          New post
        <% end %>
      </div>

      <% @recent_posts.each do |post| %>
        <%= render "posts/admin_row", post: post %>
      <% end %>

      <% if @posts.none? %>
        <p class="admin-list-empty mb-0">No posts yet.</p>
      <% end %>

      <div class="p-3 text-center border-top">
        <%= link_to "See all posts", admin_posts_path, class: "btn98 btn98-sm" %>
      </div>
    </div>
  </div>
</div>
