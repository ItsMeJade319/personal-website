<% content_for :title, "Manage gallery" %>

<div class="mb-3 d-flex justify-content-between align-items-center">
  <%= link_to admin_path, class: "text-decoration-none text-secondary small d-inline-flex align-items-center gap-1" do %>
    <i class="bi bi-arrow-left-short"></i>
    Back to dashboard
  <% end %>
  <%= link_to artworks_path, class: "text-decoration-none text-secondary small d-inline-flex align-items-center gap-1" do %>
    View public page
    <i class="bi bi-box-arrow-up-right"></i>
  <% end %>
</div>

<div class="admin-header d-flex justify-content-between align-items-center flex-wrap gap-3">
  <p class="admin-title fs-3 mb-0">All artwork</p>
  <%= link_to new_artwork_path(return_to: request.original_fullpath), class: "btn98 btn98-sm default d-inline-flex align-items-center gap-1" do %>
    <i class="bi bi-plus-lg"></i>
    New artwork
  <% end %>
</div>

<div class="admin-panel">
  <% @artworks.each do |artwork| %>
    <%= render "artworks/admin_row", artwork: artwork %>
  <% end %>

  <% if @artworks.none? %>
    <p class="admin-list-empty mb-0">No artwork yet.</p>
  <% end %>
</div>
