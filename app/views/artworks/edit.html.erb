<% content_for :title, "Editing artwork" %>

<div class="mb-3 d-flex justify-content-between align-items-center">
  <%= link_to admin_path, class: "text-decoration-none text-secondary small d-inline-flex align-items-center gap-1" do %>
    <i class="bi bi-arrow-left-short"></i>
    Back to dashboard
  <% end %>
  <%= link_to "View artwork", @artwork, class: "text-decoration-none text-secondary small" %>
</div>

<p class="admin-title fs-3 mb-4">Editing artwork</p>

<div class="admin-form-card">
  <%= render "form", artwork: @artwork %>
</div>
