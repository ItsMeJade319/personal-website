<div id="<%= dom_id artwork %>" class="col">
  <div class="window p-0 h-100 d-flex flex-column">
    <div class="title-bar" style="min-height: 24px;">
      <div class="title-bar-text small">drawing_<%= format("%02d", (local_assigns[:artwork_counter] || 0) + 1) %>.png &mdash; Paint</div>
    </div>

    <div class="window-body d-flex flex-column flex-grow-1">
      <div class="paint-frame mb-3" style="aspect-ratio: 4 / 5; overflow: hidden;">
        <% if artwork.image.attached? %>
          <%= image_tag artwork.image.variant(resize_to_limit: [ 600, 600 ]), style: "width: 100%; height: 100%; object-fit: cover;" %>
        <% else %>
          <div class="d-flex align-items-center justify-content-center h-100 text-secondary">
            <i class="bi bi-image fs-2"></i>
          </div>
        <% end %>
      </div>

      <h3 class="h6 mb-1"><%= artwork.title %></h3>

      <div class="status-bar mt-auto">
        <% meta = [ artwork.medium, artwork.year ].select(&:present?).join(", ") %>
        <% if meta.present? %>
          <p class="status-bar-field mb-0"><%= meta %></p>
        <% end %>
        <% unless artwork.published? %>
          <p class="status-bar-field mb-0">Draft</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
