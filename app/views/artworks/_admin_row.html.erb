<div class="admin-list-item">
  <% if artwork.image.attached? %>
    <%= image_tag artwork.image.variant(resize_to_limit: [ 80, 80 ]), class: "admin-thumb" %>
  <% else %>
    <div class="admin-thumb-placeholder"><i class="bi bi-image"></i></div>
  <% end %>

  <div class="flex-grow-1" style="min-width: 0;">
    <%= link_to artwork.to_s.presence || "Artwork ##{artwork.id}", edit_artwork_path(artwork, return_to: request.original_fullpath), class: "d-block text-body text-decoration-none fw-semibold text-truncate" %>
    <div class="d-flex align-items-center gap-2">
      <span class="status-pill <%= artwork.published? ? "status-pill--published" : "" %>"><%= artwork.published? ? "Published" : "Draft" %></span>
      <% if artwork.medium.present? || artwork.year.present? %>
        <span class="text-muted small"><%= [ artwork.medium, artwork.year ].select(&:present?).join(", ") %></span>
      <% end %>
    </div>
  </div>

  <div class="d-flex gap-2 flex-shrink-0">
    <%= link_to edit_artwork_path(artwork, return_to: request.original_fullpath), class: "btn98 btn98-sm" do %>
      <i class="bi bi-pencil"></i>
    <% end %>
    <%= button_to artwork_path(artwork, return_to: request.original_fullpath), method: :delete, class: "text-danger", form: { data: { turbo_confirm: "Are you sure?" } } do %>
      <i class="bi bi-trash"></i>
    <% end %>
  </div>
</div>
